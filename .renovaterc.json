{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "helpers:pinGitHubActionDigests"],
  "baseBranchPatterns": ["develop"],
  "assignees": ["mindsers"],
  "labels": ["type: dependencies"],
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Development tools in one weekly pull request",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "development tools",
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "pnpm is pinned in package.json and mise.toml: update both together",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Node.js in mise.toml is the oldest supported version: never bump its major",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "@types/node follows the oldest supported Node.js",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "The mise version installed by jdx/mise-action in the workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["version: (?<currentValue>\\S+) # mise version"],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
