{
  "name": "configfile",
  "version": "1.0.0",
  "description": "Manage your dotfiles and setup scripts from a git repository.",
  "keywords": [
    "dotfiles",
    "config",
    "cli",
    "symlink"
  ],
  "homepage": "https://github.com/mindsers/configfile#readme",
  "bugs": "https://github.com/mindsers/configfile/issues",
  "funding": "https://github.com/sponsors/mindsers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindsers/configfile.git"
  },
  "author": "Mindsers <nathanael@cherrier.dev> (https://nathanaelcherrier.dev)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "configfile": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "docs:dev": "pnpm --filter configfile-docs dev",
    "docs:build": "pnpm --filter configfile-docs build",
    "docs:commands": "node tools/docs-commands.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "node --run clean && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
